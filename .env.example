COMPOSE_PROJECT_NAME=repo-explorer
APP_ENV=development

FRONTEND_PORT=3000
INGESTOR_PORT=8001
MEMORY_PORT=8002
DEPENDENCY_GRAPH_PORT=8003
BRAIN_PORT=8004
OLLAMA_PORT=11434

# Local model service used by The Brain container.
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=granite-code:8b

# Optional if you later route The Brain to a hosted LLM API instead of Ollama.
OPENAI_API_KEY=
