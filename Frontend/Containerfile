# This file builds the Docker image for the React/Vite frontend.

# Use Node only for compiling the frontend assets.
FROM node:22-alpine AS build

# Set the container working directory for the build stage.
WORKDIR /app

# Allow compose to inject the backend and endpoint values at build time.
ARG VITE_BRAIN_BASE_URL=http://127.0.0.1:8000
ARG VITE_INGEST_ENDPOINT=/api/ingest
ARG VITE_GENERAL_CHAT_ENDPOINT=/api/chat/routed
ARG VITE_BLUEPRINT_ENDPOINT=/api/blueprint/routed
ARG VITE_VIKI_CONTEXT_ENDPOINT=/api/memory/retrieve
ARG VITE_PROMPT_CLASSIFY_ENDPOINT=/api/prompt/classify

# Expose the Vite variables to the build process.
ENV VITE_BRAIN_BASE_URL=$VITE_BRAIN_BASE_URL \
    VITE_INGEST_ENDPOINT=$VITE_INGEST_ENDPOINT \
    VITE_GENERAL_CHAT_ENDPOINT=$VITE_GENERAL_CHAT_ENDPOINT \
    VITE_BLUEPRINT_ENDPOINT=$VITE_BLUEPRINT_ENDPOINT \
    VITE_VIKI_CONTEXT_ENDPOINT=$VITE_VIKI_CONTEXT_ENDPOINT \
    VITE_PROMPT_CLASSIFY_ENDPOINT=$VITE_PROMPT_CLASSIFY_ENDPOINT

# Copy dependency metadata before source files so Docker can cache npm install.
COPY package.json package-lock.json ./

# Install exact dependencies from package-lock.json.
RUN npm ci

# Copy the Vite entry files.
COPY index.html vite.config.js ./

# Copy the React source tree.
COPY src ./src

# Build the static production assets.
RUN npm run build

# Use Nginx as the small runtime image for static assets.
FROM nginx:1.27-alpine

# Copy the SPA Nginx configuration.
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy the compiled frontend assets into Nginx's web root.
COPY --from=build /app/dist /usr/share/nginx/html

# Document that the service listens on port 80 inside the container.
EXPOSE 80

# Start Nginx in the foreground.
CMD ["nginx", "-g", "daemon off;"]
